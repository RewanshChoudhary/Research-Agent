DB_NAME=researchagent
DB_USERNAME=researchagent
DB_PASSWORD=researchagent
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8080
FRONTEND_PORT=3000
WORKER_TOKEN=dev-worker-secret
REDIS_JOB_STREAM=research:jobs:stream
REDIS_JOB_GROUP=research:workers
REDIS_DEAD_STREAM=research:jobs:dead
REDIS_CONSUMER_NAME=worker-1
GROQ_API_KEY=replace-with-your-groq-key
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.2:3b
WEAVIATE_HTTP_PORT=8081
WEAVIATE_GRPC_PORT=50051
HYDE_TOP_K=5
HYDE_N_DOCS=3
HYDE_MIN_SIMILARITY=0.70
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# ── LLM Rate Limiting ────────────────────────────────────────────────────────
# Free-tier Groq (llama-3.3-70b-versatile): 30 RPM / 6000 TPM
# Free-tier NVIDIA NIM:                     10 RPM
# Set LLM_MAX_RPM=0 to disable the RPM guard (paid tiers).
LLM_GLOBAL_CONCURRENCY=2
LLM_MAX_RPM=25
SUMMARIZER_BATCH_SIZE=5
# ── Depth-aware Source Caps ───────────────────────────────────────────────────
MAX_SOURCES_QUICK=3
MAX_SOURCES_STANDARD=5
MAX_SOURCES_DEEP=10
# ── Search Result Cache (Redis TTL in seconds; 0 = disabled) ─────────────────
DDG_CACHE_TTL=3600
